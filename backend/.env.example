PORT=3001
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/rupio-service-account.json
# Rupio issues this server-to-server API key to authorized integrating applications.
RUPIO_API_KEY=replace-with-a-long-random-rupio-api-key
RUPIO_CALLBACK_SECRET=replace-with-a-long-random-callback-secret
RUPIO_PUBLIC_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=480
# Local-only integration test page. Never enable in production.
RUPIO_TEST_PAGE_ENABLED=true
